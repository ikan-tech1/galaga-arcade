{
  "name": "galaga-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ROM-accurate Galaga web clone — Rust/WASM engine + TypeScript/WebGL client",
  "scripts": {
    "build:engine": "pnpm --filter @galaga/engine build",
    "build:shared": "pnpm --filter @galaga/shared build",
    "build:client": "pnpm --filter @galaga/client build",
    "build": "pnpm run build:shared && pnpm run build:client",
    "build:full": "pnpm run build:engine && pnpm run build:shared && pnpm run build:client",
    "dev": "pnpm run build:shared && pnpm --filter @galaga/client dev",
    "dev:client": "pnpm --filter @galaga/client dev",
    "test": "pnpm run test:engine && pnpm --filter @galaga/client test",
    "test:engine": "cd packages/engine && cargo test",
    "test:client": "pnpm --filter @galaga/client test",
    "preview": "pnpm --filter @galaga/client preview",
    "clean": "pnpm -r exec rm -rf dist node_modules pkg target",
    "vercel-build": "bash scripts/vercel-build.sh"
  },
  "packageManager": "pnpm@11.0.6",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
