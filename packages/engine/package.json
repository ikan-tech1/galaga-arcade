{
  "name": "@galaga/engine",
  "version": "1.0.0",
  "private": true,
  "main": "pkg/galaga_engine.js",
  "module": "pkg/galaga_engine.js",
  "types": "pkg/galaga_engine.d.ts",
  "exports": {
    ".": {
      "import": "./pkg/galaga_engine.js",
      "types": "./pkg/galaga_engine.d.ts"
    },
    "./wasm": "./pkg/galaga_engine_bg.wasm"
  },
  "files": [
    "pkg/"
  ],
  "description": "Rust/WASM core for Galaga (built with wasm-pack)",
  "scripts": {
    "build": "wasm-pack build --release --target web --out-dir pkg",
    "build:dev": "wasm-pack build --dev --target web --out-dir pkg",
    "test": "cargo test"
  }
}
